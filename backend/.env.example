# Allowed development frontend origins (comma-separated).
# Same-origin Vite/nginx proxies work in HTTPS mode without CORS changes.
# FastAPI remains HTTP behind that proxy; never point an HTTPS browser at it directly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# A fixed delay between stages: deterministic outcomes and progressive events.
# Use 150-400 ms for a live demo; tests override this with 0.
MOCK_STAGE_DELAY_MS=250

# In-memory storage only. Completed runs are evicted oldest-first at this limit.
MAX_RUNS=128
MAX_CONCURRENT_RUNS=8
SSE_HEARTBEAT_SECONDS=10

# Optional absolute path; defaults to ../mock-data/scenarios.json.
# MOCK_DATA_PATH=/absolute/path/to/mock-data/scenarios.json

# Explicit runtime selection; prototype never falls back to mock.
LENSGUARD_RUNTIME=mock
# The host NVIDIA gateway serves Nemotron (default) and Cosmos at this address.
PROTOTYPE_RUNTIME_URL=http://127.0.0.1:8010
INFERENCE_TIMEOUT_SECONDS=300
