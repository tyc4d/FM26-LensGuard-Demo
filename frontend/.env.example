# Same-origin API prefix. Vite proxies /api to http://127.0.0.1:8000.
# Keep this relative for both HTTP and HTTPS, including LAN clients.
VITE_API_BASE_URL=/api

# Recommended for LAN camera access after ../scripts/setup-https.sh.
# false preserves HTTP localhost development. Restart Vite after changing.
VITE_HTTPS=false

# Server-side target only; never requested directly by the browser.
API_PROXY_TARGET=http://127.0.0.1:8000
