# Optional root .env for Docker Compose (copy this file to .env).
# Generate certificates first with ./scripts/setup-https.sh.
# HTTPS is the default; set false only for HTTP localhost development.
HTTPS_ENABLED=true
VITE_API_BASE_URL=/api

# setup-https.sh accepts this as a shell environment variable, not from .env:
# LAN_IP=<your-LAN-IPv4-address> ./scripts/setup-https.sh
# Leave unset to detect the default route's address.
# Pass extra VPN IPs/hostnames as arguments: ./scripts/setup-https.sh 100.101.102.103
LAN_IP=
