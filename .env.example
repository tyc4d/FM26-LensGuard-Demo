# Optional root .env for Docker Compose (copy this file to .env).
# Generate certificates first, then use HTTPS_ENABLED=true for LAN camera demos.
HTTPS_ENABLED=false
VITE_API_BASE_URL=/api

# setup-https.sh accepts this as a shell environment variable, not from .env:
# LAN_IP=<your-LAN-IPv4-address> ./scripts/setup-https.sh
# Leave unset to detect the default route's address.
LAN_IP=
