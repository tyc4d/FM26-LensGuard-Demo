[Unit]
Description=LensGuard NVIDIA model gateway
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/FM26-LensGuard-Demo/backend
ExecStart=%h/FM26-LensGuard-Demo/backend/.venv/bin/python -m model_gateway --port 8010
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
TimeoutStopSec=300

[Install]
WantedBy=default.target
